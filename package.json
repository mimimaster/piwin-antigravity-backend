{
  "name": "piwin-antigravity-backend",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Standalone Antigravity (agy ACP + CLI) session backend extension for piwin.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "piwin": {
    "sessionBackendId": "antigravity",
    "verifiedCliVersions": [
      "1.5.5"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
